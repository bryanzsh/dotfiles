#!/bin/sh

# =====================================================================
# bspwmrc  -  Script que bspwm ejecuta al iniciar.
# Mi primera config basica: estable, ligera y facil de ampliar.
# =====================================================================

# --- Teclado ----------------------------------------------------------
# Distribucion latinoamericana. Ajusta con: setxkbmap -layout <código>
setxkbmap -layout latam

# --- Fondo de pantalla (wallpaper con feh) -----------------------------
# feh pinta la imagen y sale (no es un daemon). "--bg-fill" escala
# recortando para cubrir toda la pantalla; "--no-fehbg" evita que feh
# genere su propio mini-autostart (ya lo controlamos desde este archivo).
feh --bg-fill --no-fehbg "$HOME/Pictures/retro1.png"
# Cursor de X como flecha normal (en vez del icono por defecto).
xsetroot -cursor_name left_ptr

# --- Escritorios / Workspaces -----------------------------------------
# Creamos 9 escritorios llamados 1..9 (coinciden con Super+[1-9]).
bspc monitor -d 1 2 3 4 5 6 7 8 9

# --- Comportamiento basico de ventanas --------------------------------
bspc config border_width          1
# Color del borde: la ventana ENFOCADA (via teclado o raton) se resalta
# en blanco; el resto queda en gris oscuro discreto.
bspc config normal_border_color   "#30302f"
bspc config active_border_color   "#ffffff"
bspc config focused_border_color  "#ffffff"
bspc config window_gap           8
bspc config split_ratio         0.52

# Modo monoculo: las ventanas llenan el escritorio sin espacios muertos.
bspc config single_monocle       true
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Foco: clic activa la ventana y el cursor sigue al foco.
bspc config click_to_focus       true
bspc config pointer_follows_focus  true
bspc config follow_mouse         yes

# --- Autostart (con guardas anti-duplicado) ----------------------------
# `bspwmrc` se re-ejecuta si reinicias bspwm. Las guardas `pgrep`/`pkill`
# evitan lanzar procesos duplicados (doble consumo de RAM/CPU).

# sxhkd: daemon de atajos. Se lanza solo si no hay otro corriendo.
pgrep -x sxhkd > /dev/null || sxhkd &

# picom: compositor (sombra + blur ligero). Config en ~/.config/picom.
pgrep -x picom > /dev/null || picom --config ~/.config/picom/picom.conf &

# polybar: barra de estado. Se reinicia siempre (aplica cambios de config).
# Deteccion automatica del monitor (xrandr) en vez de hardcodear el nombre.
if [ -z "$MONITOR" ]; then
    MONITOR=$(xrandr --current | grep -w primary | awk '{print $1}')
fi
[ -z "$MONITOR" ] && MONITOR=$(xrandr --current | grep -E '\bconnected\b' | grep -v disconnected | awk '{print $1}' | head -1)
export MONITOR
pkill -x polybar 2> /dev/null
while pgrep -u "$(id -u)" -x polybar > /dev/null; do sleep 0.1; done
polybar -r main &

# VMware Tools GUI: portapapeles + drag&drop + resize host<->guest.
# (El agente vmware-user solo se auto-lanza en DE con gestor de sesion;
#  bspwm vía lightdm no lo procesa -> lo arrancamos aqui con guarda.
#  Requiere el servicio open-vm-tools.service corriendo.)
pgrep -f vmware-user > /dev/null || /usr/bin/vmware-user-suid-wrapper > /dev/null 2>&1 &